# Banco de dados (SQLite local)
DATABASE_URL="file:./dev.db"

# Segredo para assinar as sessões de login (gere um valor longo e aleatório)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Opcional: chave da API da Anthropic para o robô de conversa (Tito).
# Sem chave, o robô funciona em modo roteirizado (respostas prontas).
ANTHROPIC_API_KEY=""
# Modelo usado pelo robô
CLAUDE_MODEL="claude-opus-5-5"
